verify ${bot_reply} matches "${rfq22788_restricted_alert}" ignoring case
verify ${bot_reply} does not match "${rfq22788_campaign_or_suggestion}" ignoring case
# (BLOCK) ammonium nitrate
store "ammonium nitrate" as message
call SG_22788_Send_Message
verify ${bot_reply} matches "${rfq22788_restricted_alert}" ignoring case
verify ${bot_reply} does not match "${rfq22788_campaign_or_suggestion}" ignoring case
# (BLOCK) fire crackers
store "fire crackers" as message
call SG_22788_Send_Message
verify ${bot_reply} matches "${rfq22788_restricted_alert}" ignoring case
verify ${bot_reply} does not match "${rfq22788_campaign_or_suggestion}" ignoring case
