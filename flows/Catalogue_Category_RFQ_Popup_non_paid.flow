# Platform: mobilesite
# Imported from Testsigma: Catalogue - Category RFQ Popup (non paid) (test case 2280, run 115613, last result FAILURE)
# Tags: regression
# OFF steps: every step that would send a REAL lead / enquiry / OTP is switched off,
#   plus the checks that only pass after it. Switch them on only when a lead is wanted.

call Live_Touch_Chrome_Navigate_to_Homepage_setup_Popup
open https://www.justdial.com/Mumbai/Global-View-Opposite-Raj-Mahal-Hotel-Borivali-West/022PXX22-XX22-150314191942-T5N6_BZDET?pid=2219566662&nid=&jdmid=
delete all cookies
refresh page
wait 2 seconds
create variable pscroll with value "1200"
[ignore 30s] scroll until element catalogue_bd_category_popup visible, scroll by 600 pixels, scroll count 15, scroll wait 1
verify element catalogue_bd_category_popup is visible
verify element catalogue_page_category_rfq_popup_looking_for_text is visible
verify element catalogue_category_rfq_popup_what_type_text is visible
