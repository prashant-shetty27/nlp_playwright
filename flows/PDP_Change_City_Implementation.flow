# Platform: mobilesite
# Imported from Testsigma: PDP Change City Implementation (test case 2133, run 115613, last result FAILURE)
# Tags: regression
# OFF steps: every step that would send a REAL lead / enquiry / OTP is switched off,
#   plus the checks that only pass after it. Switch them on only when a lead is wanted.

call PS_Touch_Location_Popup
open https://www.justdial.com/jdmart/Mumbai/Tiles/jdm-1107294-ent-4-48734?srcterm=Tiles
wait 4 seconds
wait for page to load
store text of prp_search_box_city_name as searched_city
create variable CN_Category with value "Tiles"
click ps_b2b_prp_1st_product
wait 3 seconds
call SG_PRP_to_PDP_City_Change_Verification
# OFF: verify element pdp_city_icon is visible
# OFF: verify element pdp_city_name is visible
# OFF: verify element pdp_city_edit_icon is visible
# OFF: verify element pdp_change_city_link_text is visible
# OFF: store text of pdp_city_name as pdp_city_name
# OFF: click pdp_change_city_link_text
# OFF: wait 1 seconds
# OFF: verify element pdp_change_city_search_page is visible
# OFF: click touch_city_search_box
create variable CitySearch with value "Bangalore"
type "${CitySearch}" into focused field
wait 3 seconds
press key Space
wait 3 seconds
click pdp_city_change_1st_autosuggest
wait 4 seconds
verify element prp_search_box_category_name is visible
verify element prp_city_name_in_search_box contains "CitySearch"
verify element prp_result_heading contains "${CN_Category}"
verify element prp_result_heading contains "${CitySearch}"
verify text "CN_Category" on page
verify element ps_touch_b2b_city_filter contains "CitySearch"
click ps_touch_b2b_prp_1st_product
wait 3 seconds
verify element pdp_city_name contains "CitySearch"
open https://www.justdial.com/Bangalore/Crane-Manufacturers/nct-10146272?fl=undefined&ismap=undefined&subpage=&searchCase=&term=crane%2520&searchLocUpdate=0&jdxflag=0&ll=searchbox&cbflg=0&stype=category_list&srcterm=Crane%20Manufacturers&trkid=1240815-bangalore
wait 4 seconds
call PS_Touch_Consent_Popup
wait for page to load
store text of b2b_nct_city_name as B2B_NCT_CityName
create variable CN_Category with value "Cranes"
scroll to nct_recommended_products_carousel_section
click nct_recommended_products_1st_product
wait 3 seconds
call SG_NCT_to_PDP_City_Change_Verification
call SG_PDP_Change_City_Pune_Cranes
open https://www.justdial.com/Delhi/Robocura-Opp-Pillar-No-119-Ghitorni/011PXX11-XX11-190725175424-B1S6_BZDET?pid=219902361&nid=12408409&jdmid=jdm-1572310-ent-4-13136228
wait 4 seconds
scroll to catalogue_products_tab
click catalogue_products_tab
wait 3 seconds
scroll to catalogue_products_tab_1st_product
create variable CitySearch with value "Pune"
store text of catalogue_city_name as Catalogue_City
store text of catalogue_products_tab_1st_product as catalogue_popular_product_1st
click catalogue_products_tab_1st_product
wait 3 seconds
verify element pdp_product_name_heading contains "${catalogue_popular_product_1st}"
call SG_PDP_Change_City_via_Catalogue
call SG_PDP_Change_City_Mumbai_Lixo_Chair
open https://www.justdial.com/jdmart
call SG_Home_Flow_PDP_City_Change
call SG_PDP_Change_City_All_India
