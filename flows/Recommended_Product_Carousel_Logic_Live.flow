# Platform: mobilesite
# Params : rp_api_base_live live_url_school_bag_manufacturers live_url_pani_puri_making_machine live_url_steel_merchants live_url_carpet_wholesalers live_url_bulk_sms_services
# GJDT-22686 — 'Recommended Products For You' carousel on the B2B NCT results page.
# For each search URL: the city, ncatid and search term are read from the URL
# that was opened, the get_product_by_ncatid API is called for THAT search, the
# first card must match the API, and both API and page must follow the priority
# hierarchy (DS > search city > price, each exhausted before the next).
# LIVE (www.justdial.com) clone of the devx case — no HTTP auth needed.

# --- school bag manufacturers ---
open ${live_url_school_bag_manufacturers}
wait 3 seconds
verify element rp_heading_h1 is visible
verify element rp_carousel_heading is visible
verify text "Recommended Products For You" on page
verify element rp_product_1st is visible
verify element rp_product_1st_price is visible
store count of rp_product_names as productCount1
verify stored productCount1 is not "0"
# the search this page is for, read from its own URL
store regex "justdial\.com/([^/]+)/" from page url as city1
store regex "justdial\.com/[^/]+/([^/?]+)/nct-" from page url as query1
store regex "nct-(\d+)" from page url as ncatid1
api get "${rp_api_base_live}&city=${city1}&ncatid=${ncatid1}&query=${query1}" as apiResp1
store json apiResp1 path results.data.0.display_name1 as apiName1
store json apiResp1 path results.data.0.company_name as apiCompany1
store text of rp_product_1st_name as uiName1
verify stored uiName1 contains "${apiName1}"
store text of rp_product_1st_company as uiCompany1
verify stored uiCompany1 contains "${apiCompany1}"
# GJDT-22686 priority: DS > search city > price, exhausted in that order
verify recommended products order in apiResp1
verify recommended products carousel order on page

