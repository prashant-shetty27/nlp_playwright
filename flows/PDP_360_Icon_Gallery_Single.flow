# Platform: mobilesite
# Story: GJDT-22417 — 360° icon on the single-image (gallery) view, measured on the first 4 photos (AC2, AC6 gallery)
# Tags: b2b, pdp, 360, GJDT-22417
open ${prot3_pdp_360_photos}
wait for page to load
wait 4 seconds
verify element pdp_first_photo is visible
click pdp_first_photo
wait 3 seconds
verify element gallery_360_icon is visible
store javascript "(function(){var slides=[...document.querySelectorAll(".swiper-slide")]; var cur=null; slides.forEach(function(s){var im=s.querySelector("img"); if(!im) return; var r=im.getBoundingClientRect(); if(r.width>200&&r.left>-2&&r.left<2) cur=s;}); if(!cur) return "FAIL no visible slide"; var im=cur.querySelector("img"); var ir=im.getBoundingClientRect(); var nw=im.naturalWidth||1, nh=im.naturalHeight||1; var sc=Math.min(ir.width/nw, ir.height/nh); var rw=nw*sc, rh=nh*sc; var box={left:ir.left+(ir.width-rw)/2, top:ir.top+(ir.height-rh)/2}; box.right=box.left+rw; box.bottom=box.top+rh; var icn=cur.querySelector(".glyprvw__img3dicn"); if(!icn||!icn.getBoundingClientRect().width) return "FAIL no 360 icon on slide "+(slides.indexOf(cur)+1); var cr=icn.getBoundingClientRect(); var ot=Math.round(cr.top-box.top), orr=Math.round(box.right-cr.right); var inside=cr.top>=box.top-1&&cr.right<=box.right+1&&cr.left>=box.left-1&&cr.bottom<=box.bottom+1; var counter=(document.body.innerText.match(/\d+\s*\/\s*\d+/)||[""])[0]; return (inside?"OK ":"FAIL ")+"slide "+counter+" image="+Math.round(rw)+"x"+Math.round(rh)+" (natural "+nw+"x"+nh+") icon="+Math.round(cr.width)+"x"+Math.round(cr.height)+" offsetTop="+ot+" offsetRight="+orr+(inside?"":" — icon outside the image (cropped)");})()" as gallery_icon_1
take screenshot as gallery_photo_1
verify stored gallery_icon_1 contains "OK"
swipe left
wait 2 seconds
store javascript "(function(){var slides=[...document.querySelectorAll(".swiper-slide")]; var cur=null; slides.forEach(function(s){var im=s.querySelector("img"); if(!im) return; var r=im.getBoundingClientRect(); if(r.width>200&&r.left>-2&&r.left<2) cur=s;}); if(!cur) return "FAIL no visible slide"; var im=cur.querySelector("img"); var ir=im.getBoundingClientRect(); var nw=im.naturalWidth||1, nh=im.naturalHeight||1; var sc=Math.min(ir.width/nw, ir.height/nh); var rw=nw*sc, rh=nh*sc; var box={left:ir.left+(ir.width-rw)/2, top:ir.top+(ir.height-rh)/2}; box.right=box.left+rw; box.bottom=box.top+rh; var icn=cur.querySelector(".glyprvw__img3dicn"); if(!icn||!icn.getBoundingClientRect().width) return "FAIL no 360 icon on slide "+(slides.indexOf(cur)+1); var cr=icn.getBoundingClientRect(); var ot=Math.round(cr.top-box.top), orr=Math.round(box.right-cr.right); var inside=cr.top>=box.top-1&&cr.right<=box.right+1&&cr.left>=box.left-1&&cr.bottom<=box.bottom+1; var counter=(document.body.innerText.match(/\d+\s*\/\s*\d+/)||[""])[0]; return (inside?"OK ":"FAIL ")+"slide "+counter+" image="+Math.round(rw)+"x"+Math.round(rh)+" (natural "+nw+"x"+nh+") icon="+Math.round(cr.width)+"x"+Math.round(cr.height)+" offsetTop="+ot+" offsetRight="+orr+(inside?"":" — icon outside the image (cropped)");})()" as gallery_icon_2
take screenshot as gallery_photo_2
verify stored gallery_icon_2 contains "OK"
swipe left
wait 2 seconds
store javascript "(function(){var slides=[...document.querySelectorAll(".swiper-slide")]; var cur=null; slides.forEach(function(s){var im=s.querySelector("img"); if(!im) return; var r=im.getBoundingClientRect(); if(r.width>200&&r.left>-2&&r.left<2) cur=s;}); if(!cur) return "FAIL no visible slide"; var im=cur.querySelector("img"); var ir=im.getBoundingClientRect(); var nw=im.naturalWidth||1, nh=im.naturalHeight||1; var sc=Math.min(ir.width/nw, ir.height/nh); var rw=nw*sc, rh=nh*sc; var box={left:ir.left+(ir.width-rw)/2, top:ir.top+(ir.height-rh)/2}; box.right=box.left+rw; box.bottom=box.top+rh; var icn=cur.querySelector(".glyprvw__img3dicn"); if(!icn||!icn.getBoundingClientRect().width) return "FAIL no 360 icon on slide "+(slides.indexOf(cur)+1); var cr=icn.getBoundingClientRect(); var ot=Math.round(cr.top-box.top), orr=Math.round(box.right-cr.right); var inside=cr.top>=box.top-1&&cr.right<=box.right+1&&cr.left>=box.left-1&&cr.bottom<=box.bottom+1; var counter=(document.body.innerText.match(/\d+\s*\/\s*\d+/)||[""])[0]; return (inside?"OK ":"FAIL ")+"slide "+counter+" image="+Math.round(rw)+"x"+Math.round(rh)+" (natural "+nw+"x"+nh+") icon="+Math.round(cr.width)+"x"+Math.round(cr.height)+" offsetTop="+ot+" offsetRight="+orr+(inside?"":" — icon outside the image (cropped)");})()" as gallery_icon_3
take screenshot as gallery_photo_3
verify stored gallery_icon_3 contains "OK"
swipe left
wait 2 seconds
store javascript "(function(){var slides=[...document.querySelectorAll(".swiper-slide")]; var cur=null; slides.forEach(function(s){var im=s.querySelector("img"); if(!im) return; var r=im.getBoundingClientRect(); if(r.width>200&&r.left>-2&&r.left<2) cur=s;}); if(!cur) return "FAIL no visible slide"; var im=cur.querySelector("img"); var ir=im.getBoundingClientRect(); var nw=im.naturalWidth||1, nh=im.naturalHeight||1; var sc=Math.min(ir.width/nw, ir.height/nh); var rw=nw*sc, rh=nh*sc; var box={left:ir.left+(ir.width-rw)/2, top:ir.top+(ir.height-rh)/2}; box.right=box.left+rw; box.bottom=box.top+rh; var icn=cur.querySelector(".glyprvw__img3dicn"); if(!icn||!icn.getBoundingClientRect().width) return "FAIL no 360 icon on slide "+(slides.indexOf(cur)+1); var cr=icn.getBoundingClientRect(); var ot=Math.round(cr.top-box.top), orr=Math.round(box.right-cr.right); var inside=cr.top>=box.top-1&&cr.right<=box.right+1&&cr.left>=box.left-1&&cr.bottom<=box.bottom+1; var counter=(document.body.innerText.match(/\d+\s*\/\s*\d+/)||[""])[0]; return (inside?"OK ":"FAIL ")+"slide "+counter+" image="+Math.round(rw)+"x"+Math.round(rh)+" (natural "+nw+"x"+nh+") icon="+Math.round(cr.width)+"x"+Math.round(cr.height)+" offsetTop="+ot+" offsetRight="+orr+(inside?"":" — icon outside the image (cropped)");})()" as gallery_icon_4
take screenshot as gallery_photo_4
verify stored gallery_icon_4 contains "OK"
