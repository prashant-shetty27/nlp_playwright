# OFF: click if visible b2b_prp_all_india_location_pop_cross
# OFF: scroll until element prp_all_india_people_also_search_carousel visible, scroll by 600 pixels, scroll count 15, scroll wait 1
wait 1 seconds
# Testsigma scrolled until the GVS popup opened (it opens when the page is scrolled):
scroll down 1200
wait until element b2b_prp_gvs_popup is visible up to 30 seconds
wait 3 seconds
run javascript "document.querySelector('[class*="skipbtn"]').click();"
