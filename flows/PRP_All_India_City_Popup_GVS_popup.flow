wait 3 seconds
call PS_consent_popup
scroll to prp_bd7_banner_section
verify element prp_bd7_banner_section is visible
# OFF: scroll until element prp_all_india_city_banner_section visible, scroll by 600 pixels, scroll count 15, scroll wait 1
