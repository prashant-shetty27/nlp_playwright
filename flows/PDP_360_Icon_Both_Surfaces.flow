# Platform: mobilesite
# Story: GJDT-22417 — the icon is the same size and sits in the same place on the Photos grid and in the gallery view (AC6)
# Tags: b2b, pdp, 360, GJDT-22417
open ${prot3_pdp_360_photos}
wait for page to load
wait 4 seconds
store javascript "(function(){var tiles=[...document.querySelectorAll(".photos_tab_imgcontainer")]; if(!tiles.length) return "FAIL no photo tiles"; var res=[],offs=[]; tiles.forEach(function(t,i){var img=t.querySelector("img.glyimg"); var icn=t.querySelector(".glyimg__img3dicn"); if(!img) return; var ir=img.getBoundingClientRect(); if(ir.width<20) return; if(!icn||!icn.getBoundingClientRect().width){res.push("tile"+i+":no-icon"); return;} var cr=icn.getBoundingClientRect(); var ot=Math.round(cr.top-ir.top), orr=Math.round(ir.right-cr.right); var inside=cr.top>=ir.top-0.5&&cr.left>=ir.left-0.5&&cr.right<=ir.right+0.5&&cr.bottom<=ir.bottom+0.5; offs.push(ot+"/"+orr+"/"+Math.round(cr.width)); if(!inside) res.push("tile"+i+":cropped top="+ot+" right="+orr);}); var uniq=[...new Set(offs)]; if(uniq.length>1) res.push("position varies: "+uniq.join(" vs ")); return (res.length?"FAIL ":"OK ")+"tiles="+tiles.length+" measured="+offs.length+" offsetTop/offsetRight/size="+uniq.join(",")+(res.length?" | "+res.join("; "):"");})()" as grid_check
store javascript "(function(){var t=document.querySelector('.photos_tab_imgcontainer'); var img=t.querySelector('img.glyimg'), icn=t.querySelector('.glyimg__img3dicn'); var ir=img.getBoundingClientRect(), cr=icn.getBoundingClientRect(); return 'grid icon '+Math.round(cr.width)+'x'+Math.round(cr.height)+' offsetTop='+Math.round(cr.top-ir.top)+' offsetRight='+Math.round(ir.right-cr.right);})()" as grid_icon_geometry
click pdp_first_photo
wait 3 seconds
store javascript "(function(){var slides=[...document.querySelectorAll(".swiper-slide")]; var cur=null; slides.forEach(function(s){var im=s.querySelector("img"); if(!im) return; var r=im.getBoundingClientRect(); if(r.width>200&&r.left>-2&&r.left<2) cur=s;}); if(!cur) return "FAIL no visible slide"; var im=cur.querySelector("img"); var ir=im.getBoundingClientRect(); var nw=im.naturalWidth||1, nh=im.naturalHeight||1; var sc=Math.min(ir.width/nw, ir.height/nh); var rw=nw*sc, rh=nh*sc; var box={left:ir.left+(ir.width-rw)/2, top:ir.top+(ir.height-rh)/2}; box.right=box.left+rw; box.bottom=box.top+rh; var icn=cur.querySelector(".glyprvw__img3dicn"); if(!icn||!icn.getBoundingClientRect().width) return "FAIL no 360 icon on slide "+(slides.indexOf(cur)+1); var cr=icn.getBoundingClientRect(); var ot=Math.round(cr.top-box.top), orr=Math.round(box.right-cr.right); var inside=cr.top>=box.top-1&&cr.right<=box.right+1&&cr.left>=box.left-1&&cr.bottom<=box.bottom+1; var counter=(document.body.innerText.match(/\d+\s*\/\s*\d+/)||[""])[0]; return (inside?"OK ":"FAIL ")+"slide "+counter+" image="+Math.round(rw)+"x"+Math.round(rh)+" (natural "+nw+"x"+nh+") icon="+Math.round(cr.width)+"x"+Math.round(cr.height)+" offsetTop="+ot+" offsetRight="+orr+(inside?"":" — icon outside the image (cropped)");})()" as gallery_check
take screenshot as both_surfaces_gallery
store javascript "(function(){var g='${grid_icon_geometry}'; var m=g.match(/(\d+)x(\d+) offsetTop=(-?\d+) offsetRight=(-?\d+)/); var s='${gallery_check}'; var n=s.match(/icon=(\d+)x(\d+) offsetTop=(-?\d+) offsetRight=(-?\d+)/); if(!m||!n) return 'FAIL could not read geometry: '+g+' / '+s; var dsize=Math.abs(+m[1]-+n[1]), dr=Math.abs(+m[4]-+n[4]); return (dsize<=2&&dr<=4?'OK ':'FAIL ')+'grid '+m[1]+'px @right '+m[4]+'px vs gallery '+n[1]+'px @right '+n[4]+'px (size diff '+dsize+'px, right-offset diff '+dr+'px)';})()" as surface_comparison
verify stored surface_comparison contains "OK"
