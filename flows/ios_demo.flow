# flows/ios_demo.flow
# JustDial iOS App — Real Device Demo
# Validates full Appium XCUITest pipeline: install IPA, launch, verify home screen.
# ──────────────────────────────────────────────────────────────────────────────

# Wait for app to install and load
wait 8 seconds

# Dismiss system permission dialogs — autoAcceptAlerts=false so we control each one.
# "dismiss" action = "Don't Allow" on permission dialogs (denies contacts, location etc.)
# Three passes to catch staggered alerts (location fires first, then contacts, etc.)
dismiss alerts
wait 1 seconds
dismiss alerts
wait 1 seconds
dismiss alerts
wait 1 seconds

# Dismiss app-level onboarding if present
tap if exists agree_and_continue
tap if exists skip_button
wait 1 seconds

# Take screenshot of home screen
take screenshot as ios_justdial_home

# Verify the app loaded — look for JustDial branding
verify text "${verify_keyword}"

# Take screenshot after verification
take screenshot as ios_justdial_verified

# Wait and take final screenshot
wait 3 seconds
take screenshot as ios_justdial_done
