# Platform: mobilesite
# Imported from Testsigma: NCT Job-related Questions (run 114314, B2B Touch (8AM), Samsung Galaxy S24)
# Lines starting with '# UNSUPPORTED' or '# IF' need a manual decision.
# Tags: regression
# REAL LEADS: the Send Enquiry submit + OTP steps and the Get Best Price submit are OFF so scheduled runs never send
#   leads to clients. Switch them on only when a lead is wanted.
# Get Best Price 'No' option: only shown to a signed-in user (the OTP enquiry used to sign in), so it is OFF too.
# Other OFF steps: the mobile Send Enquiry form has no Name field; mobile Get Best Price keeps Submit disabled
#   until an option is chosen (no 'Please select one option' text); three pop-up checks near the top are also OFF.

open https://www.justdial.com/Mumbai/Multinational-Companies-in-Link-Road-Malad-West/nct-10332493?fl=undefined&ismap=undefined&subpage=&searchCase=&term=multinat&searchLocUpdate=0&jdxflag=0&ll=searchbox&cbflg=1&stype=category_list&srcterm=Multinational%20Companies&trkid=13116826-mumbai
wait 3 seconds
call PS_Touch_Consent_Popup
scroll until element send_enquiry_button_1st visible, scroll by 500 pixels, scroll count 15, scroll wait 1
click send_enquiry_button_1st
verify element heading_send_enquiry_ps is visible
verify text "Get the free contact details in seconds for Multinational Companies" on page
verify element heading_free_contact_details_ps is visible
# OFF: verify element heading_need_immediate_assistance is visible
# OFF: verify element image_vendor_image is visible
# OFF: verify element call_now_free_button1 is visible
click send_enquiry_back_ps
wait 3 seconds
verify element call_popup_seller_name is visible
verify element seller_call_pop_image is visible
verify element seller_call_pop_rating is visible
verify element seller_call_pop_area is visible
verify element seller_call_pop_heading_just_a_call_away is visible
verify element seller_call_pop_get_your_answers_instantly is visible
verify element seller_user_details_form is visible
verify element enquiry_default_text is visible
click enquiry_seller_pop_skip
wait 1 seconds
scroll until element send_enquiry_button_1st visible, scroll by 500 pixels, scroll count 15, scroll wait 1
click send_enquiry_button_1st
wait 1 seconds
# OFF: type "Prashant" into enquiry_form_name
type "7738176962" into enquiry_form_mobile
click enquiry_form_no
# OFF: js click enquiry_submit_button
# OFF: wait until element otp_1st_field is visible
# OFF: enter otp "537393" into otp_fields
# OFF: wait 1 seconds
# OFF: verify text "Dear Prashant" on page
click send_enquiry_back_ps
open https://www.justdial.com/Mumbai/Corporate-Companies-in-Link-Road-Malad-West/nct-10138533?fl=undefined&ismap=undefined&subpage=&searchCase=&term=corporate%2520com&searchLocUpdate=0&jdxflag=0&ll=searchbox&cbflg=1&stype=category_list&srcterm=Corporate%20Companies&trkid=13702-mumbai
wait 4 seconds
scroll down 1000
verify text "Placement Services" on page
scroll down 2000
scroll until text "Get Best Price" visible, scroll count 10, scroll wait 1
click if visible enquiry_seller_pop_skip
scroll to gbp_button_11
js click gbp_button_11
wait 2 seconds
js click get_best_price_any_button
wait 2 seconds
verify element gbp_sheet_heading is visible
