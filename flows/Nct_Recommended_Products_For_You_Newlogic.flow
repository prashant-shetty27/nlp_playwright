# --- Purpose: TC_DEFECT_22699_NO_PRICE_ON_REQUEST [sanity] — "Price on Request" never shown on carousel cards
open ${Prod_Brick_Wholesalers}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
verify element rp_carousel_price_on_request is not visible
open ${Prod_Carpet_Wholesalers}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
verify element rp_carousel_price_on_request is not visible
# --- Purpose: TC_DEFECT_22700 / TC_RP_CTA_IS_CALL_NOW [sanity] — carousel CTA reads "Call Now", no "View Details"
open ${Prod_Umbrella_Distributors}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
verify element rp_carousel_call_now_cta is visible
verify element rp_carousel_call_now_cta contains "Call Now"
verify element rp_carousel_view_details is not visible
open ${live_url_steel_merchants}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
verify element rp_carousel_call_now_cta is visible
verify element rp_carousel_call_now_cta contains "Call Now"
verify element rp_carousel_view_details is not visible
# --- Purpose: TC_RP_NO_SECTION_FOR_INELIGIBLE_CATEGORY [sanity] — no carousel when nothing qualifies
open ${prod_Bat_Distributors_MRF}
wait for result page load
click if visible login_prompt_skip
wait 3 seconds
verify element rp_carousel_heading is not visible
# --- Purpose: TC_ASK_FOR_PRICE_LEAD_SUBMIT_FLOW [full] — devx only. OFF by default: every run submits ONE REAL lead (sent to ~7 vendors). Turn the lines on only when a lead is wanted.
# OFF: open ${devx}
# OFF: open ${url_carpet_wholesalers}
# OFF: wait for result page load
# OFF: click if visible login_prompt_skip
# OFF: wait 3 seconds
# OFF: verify element rp_carousel_heading is visible
# OFF: store regex "justdial\.com/([^/]+)/" from page url as leadCity
# OFF: store lowercase of "${leadCity}" as leadCityLower
# OFF: store regex "nct-(\d+)" from page url as leadNcatid
# OFF: verify element rp_carousel_ask_for_price_cta contains "Ask for Price"
# OFF: click rp_carousel_ask_for_price_cta
# OFF: wait until element mobile_number_input is visible
# OFF: type "${test_mobile}" into mobile_number_input
# OFF: click popup_submit_button
# OFF: wait until element otp_input is visible
# OFF: wait 5 seconds
# OFF: api get "http://192.168.131.12/communication/api/v1/get_events?mobileEmail=${test_mobile}&vertical=OTP" as otpResp
# OFF: store json otpResp path data.response.0.sms.text as otpText
# OFF: store regex "(\d{4,8})" from otpText as otp
# OFF: enter otp "${otp}" into otp_input
# OFF: wait 6 seconds
# OFF: get today as d
# OFF: format date "${d}" as "YYYY-MM-DD" into today
# OFF: api get "http://192.168.35.197:8111/lead_gen.php?city=${leadCityLower}&date=${today}&mobile=${test_mobile}&msg=1&dev=1" as leadGenResp
# OFF: verify stored leadGenResp contains "\"ld_tp\":\"get_best_price\""
# OFF: verify stored leadGenResp contains "\"ld_pg\":\"rsltpge\""
# OFF: verify stored leadGenResp contains "\"ld_tp_pos\":\"recommended-products\""
# OFF: verify stored leadGenResp contains "\"bd\":1"
# OFF: verify stored leadGenResp contains "'national_catid': '${leadNcatid}'"
# OFF: verify network request containing "submit__gbp_afp_b2b_plisting_carousel" was sent
