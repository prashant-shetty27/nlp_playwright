# Platform: mobilesite
# Params : live_url_steel_merchants live_url_bulk_sms_services rp_api_base_live prod_Hotel_Equipment_Manufacturers prod_Screw_Importers live_url_pani_puri_making_machine live_url_school_bag_manufacturers live_url_carpet_wholesalers Prod_Brick_Wholesalers Prod_Carpet_Wholesalers Prod_Umbrella_Distributors prod_Bat_Distributors_MRF
# GJDT-22686 — Recommended Products / Services For You on the B2B NCT results page (LIVE).
# Each block: open a search URL, read city / ncatid / search term from that URL,
# call get_product_by_ncatid for the same search, and check the carousel shows the
# same first 3 products, in the same order, as the API (plain store / verify steps).
# The DS > search city > price ranking itself is the API's job: it cannot be asserted
# with plain steps on live data that changes daily, so it is not checked here.

# --- Purpose: TC_RP_HEADING_PRODUCT [smoke] — product category shows "Recommended Products For You"
open ${live_url_steel_merchants}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
verify element rp_carousel_heading has text "Recommended Products For You"
verify element rp_product_1st is visible
# --- Purpose: TC_RP_HEADING_SERVICE [sanity] — service category heading (sheet expects "Recommended Services For You"; live shows "Products" — confirm with dev)
open ${live_url_bulk_sms_services}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
verify element rp_carousel_heading contains "Recommended"
verify element rp_carousel_heading contains "For You"
verify element rp_product_1st is visible
# --- Purpose: TC_RP_PRIORITY_STEEL_MERCHANTS [sanity] — first 3 carousel products match the API, same order (Mumbai)
open ${live_url_steel_merchants}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
call store_prp_url_city_nctid_queryparam_api_pass
store json apiResp1 path results.data.0.display_name1 as api1_name1
store json apiResp1 path results.data.1.display_name1 as api1_name2
store json apiResp1 path results.data.2.display_name1 as api1_name3
store text of rp_product_1st_name as page1_name1
store text of rp_product_2nd_name as page1_name2
store text of rp_product_3rd_name as page1_name3
verify stored page1_name1 equals "${api1_name1}"
verify stored page1_name2 equals "${api1_name2}"
verify stored page1_name3 equals "${api1_name3}"
# --- Purpose: TC_RP_PRIORITY_BULK_SMS [sanity] — service category: first 3 carousel products match the API
open ${live_url_bulk_sms_services}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
store regex "justdial\.com/([^/]+)/" from page url as city2
store regex "justdial\.com/[^/]+/([^/?]+)/nct-" from page url as query2
store regex "nct-(\d+)" from page url as ncatid2
api get "${rp_api_base_live}&city=${city2}&ncatid=${ncatid2}&query=${query2}" as apiResp2
store json apiResp2 path results.data.0.display_name1 as apiName2
store text of rp_product_1st_name as uiName2
verify stored apiResp2 contains "${uiName2}"
store json apiResp2 path results.data.0.display_name1 as api2_name1
store json apiResp2 path results.data.1.display_name1 as api2_name2
store json apiResp2 path results.data.2.display_name1 as api2_name3
store text of rp_product_1st_name as page2_name1
store text of rp_product_2nd_name as page2_name2
store text of rp_product_3rd_name as page2_name3
verify stored page2_name1 equals "${api2_name1}"
verify stored page2_name2 equals "${api2_name2}"
verify stored page2_name3 equals "${api2_name3}"
# --- Purpose: TC_RP_360_BADGE_ON_TOP [sanity] — carousel has products (360 badges counted) and matches the API
open ${prod_Hotel_Equipment_Manufacturers}
wait for result page load
click if visible login_prompt_skip
wait until element rp_carousel_heading is visible
verify element rp_carousel_heading is visible
store count of rp_carousel_cards as productCount
verify stored productCount is greater than 0
store count of rp_carousel_360_badge as badgeCount
call store_prp_url_city_nctid_queryparam_api_pass
store json apiResp1 path results.data.0.display_name1 as api360_name1
store json apiResp1 path results.data.1.display_name1 as api360_name2
store json apiResp1 path results.data.2.display_name1 as api360_name3
store text of rp_product_1st_name as page360_name1
store text of rp_product_2nd_name as page360_name2
store text of rp_product_3rd_name as page360_name3
verify stored page360_name1 equals "${api360_name1}"
verify stored page360_name2 equals "${api360_name2}"
verify stored page360_name3 equals "${api360_name3}"
