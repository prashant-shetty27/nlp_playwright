{
  "manifest_version": 3,
  "name": "ML Codeless Spy",
  "version": "2.0",
  "description": "Captures element DNA for ML-driven test automation. Alt/Option+Click any element to record it into the side panel.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open ML Spy Recorder"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "incognito": "spanning"
}